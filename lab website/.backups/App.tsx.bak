              darkMode
                ? "bg-gray-800 border-gray-700"
                : "bg-white border-stone-200"
            } border p-8`}
            style={{ boxShadow: "0 24px 64px rgba(0,0,0,0.3)" }}
          >
            <div className="flex items-center justify-between mb-6">
              <h2
                className="font-bold"
                style={{
                  fontFamily: "Playfair Display, serif",
                  fontSize: "32px",
                }}
              >
                Join Our Lab
              </h2>
              <button
