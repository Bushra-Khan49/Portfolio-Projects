            </button>
          </div>
        </div>

        {/* Mobile Menu */}
        {mobileMenuOpen && (
          <div
            className={`lg:hidden border-t ${navScrolled || darkMode ? "border-gray-800 bg-gray-900" : "border-stone-200 bg-white"}`}
